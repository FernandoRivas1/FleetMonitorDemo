# Copy to .env for local development. Never commit the real .env file.

# Postgres (Neon) — used for both local dev and production. Required; the
# app fails fast on startup if this isn't set. Get a free one at neon.tech:
# create a project, copy the connection string (works as-is — this app
# normalizes the postgres://... / postgresql://... scheme itself).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Comma-separated list of origins allowed to call this API. Add your Vercel
# frontend URL here in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. If unset, POST /assistant/ask falls back to a free rule-based
# answer instead of calling the Claude API.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Synthetic fleet size range used by the seed script.
FLEET_MIN=15
FLEET_MAX=20
