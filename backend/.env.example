# Copy to .env for local development. Never commit the real .env file.

# SQLite by default (a local file, created automatically). For production,
# point this at a Postgres/Neon connection string instead, e.g.:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./fleetmonitor.db

# Comma-separated list of origins allowed to call this API. Add your Vercel
# frontend URL here in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. If unset, POST /assistant/ask falls back to a free rule-based
# answer instead of calling the Claude API.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Synthetic fleet size range used by the seed script.
FLEET_MIN=15
FLEET_MAX=20
